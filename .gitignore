*_key.pem
*.key
*.pfx
*.p12

# 本地运行痕迹
*.log
*.dmp
*.zip
*.png
__pycache__/

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store

dist/

# 只在本地保留的技术文档，不进仓库
docs/

# 除 README.md 外的一切 markdown 都不上传
*.md
!README.md
