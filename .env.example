# Copy this file to .env. Docker Compose reads .env automatically.
GRADLE_IMAGE=gradle:9.8.1-jdk21
NODE_IMAGE=node:22-bookworm-slim
JRE_IMAGE=eclipse-temurin:21-jre
MONGO_IMAGE=mongo:7.0

# Host ports. The game client expects these ports, so dev and run use the same values.
ASTAPS_HTTP_PORT=8088
ASTAPS_GAME_PORT=22101
